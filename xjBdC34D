### 4.11 — GLSL Shaders

#### `assets/shaders/world/world.vert`
```glsl
#version 330 core
layout(location=0) in vec3 aPos;
layout(location=1) in vec3 aNormal;
layout(location=2) in vec2 aTexCoord;
out vec2 TexCoord;
out vec3 FragPos;
out vec3 Normal;
uniform mat4 model, view, projection;
uniform float time;
uniform float fearFactor;   // 0.0-1.0
void main() {
    vec3 pos = aPos;
    // Subtle geometry warp at high fear (walls breathe)
    pos.x += sin(pos.y * 3.0 + time * 1.5) * fearFactor * 0.025;
    pos.y += cos(pos.x * 2.0 + time * 1.2) * fearFactor * 0.015;
    FragPos  = vec3(model * vec4(pos, 1.0));
    Normal   = mat3(transpose(inverse(model))) * aNormal;
    TexCoord = aTexCoord;
    gl_Position = projection * view * vec4(FragPos, 1.0);
}
```

#### `assets/shaders/world/world.frag`
```glsl
#version 330 core
in vec2  TexCoord;
in vec3  FragPos;
in vec3  Normal;
out vec4 FragColor;
uniform sampler2D texture1;
uniform vec3      lightPos;
uniform vec3      viewPos;
uniform float     time;
uniform float     fearFactor;   // 0.0-1.0 (fear level / 100)
uniform float     chaseFactor;  // 0.0 or 1.0 — Antoni is chasing

void main() {
    vec2 uv = TexCoord;
    // UV distortion during chase
    uv.x += sin(uv.y * 8.0 + time * 4.0) * fearFactor * 0.02;

    vec4  texColor = texture(texture1, uv);
    vec3  norm     = normalize(Normal);
    vec3  lightDir = normalize(lightPos - FragPos);
    float diff     = max(dot(norm, lightDir), 0.2);

    // Harsh red tint when Antoni is chasing
    vec3  chaseRed = mix(vec3(1.0), vec3(1.5, 0.3, 0.3), chaseFactor * 0.7);
    // Desaturate + darken at high fear (market feels oppressive)
    vec3  color    = texColor.rgb * diff * chaseRed;
    float lum      = dot(color, vec3(0.299, 0.587, 0.114));
    color = mix(color, vec3(lum * 0.6), fearFactor * 0.45);

    FragColor = vec4(color, texColor.a);
}
```

#### `assets/shaders/post/post.frag`
```glsl
#version 330 core
in  vec2      TexCoord;
out vec4      FragColor;
uniform sampler2D screenTexture;
uniform float     fearFactor;       // 0.0-1.0
uniform float     time;
uniform float     chaseFactor;      // 0.0-1.0 (is Antoni chasing?)
uniform float     slipFactor;       // 0.0-1.0 (player slipping on oil)
uniform float     jumpscareT;       // 0.0-1.0 (jumpscare flash)

void main() {
    vec2 uv = TexCoord;

    // Chromatic aberration (fear-driven)
    float aberr = fearFactor * 0.015 + chaseFactor * 0.025;
    float r = texture(screenTexture, uv + vec2( aberr, 0.0)).r;
    float g = texture(screenTexture, uv).g;
    float b = texture(screenTexture, uv - vec2( aberr, 0.0)).b;

    // Slip effect: rotational smear
    float slipShift = sin(time * 12.0) * slipFactor * 0.03;
    uv.x += slipShift;
    uv.y += cos(time * 10.0) * slipFactor * 0.02;

    // Screen warp during chase
    uv.x += sin(uv.y * 15.0 + time * 6.0) * chaseFactor * 0.005;

    // Vignette (stronger during chase)
    vec2  vigUV = uv * (1.0 - uv.yx);
    float vig   = pow(clamp(vigUV.x * vigUV.y * 15.0, 0.0, 1.0),
                      0.25 + fearFactor * 0.6 + chaseFactor * 0.8);

    // Film grain
    float noise = fract(sin(dot(uv + time * 0.001,
                    vec2(127.1, 311.7))) * 43758.5453);

    vec3 color = vec3(r, g, b);
    color *= vig;
    color += (noise - 0.5) * 0.03 * fearFactor;

    // Scanlines (fear-driven, retro horror look)
    color -= sin(uv.y * 900.0) * 0.03 * fearFactor;

    // Baby oil smear (slipping): iridescent sheen
    vec3 oilSheen = vec3(0.9, 0.95, 1.1) * slipFactor * 0.25;
    color += oilSheen;

    // Jumpscare flash: white-out
    color = mix(color, vec3(1.0, 0.95, 0.9), jumpscareT * 0.9);

    FragColor = vec4(clamp(color, 0.0, 1.0), 1.0);
}
