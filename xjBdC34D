    input.Init(win);
    SaveLoad::LoadSettings(state);

    UIRenderer    ui;    ui.Init(W, H);
    PostProcess   post;  post.Init(W, H);

    // Heap-allocated heavy objects (after loading screen)
    Camera*        cam       = nullptr;
    MarketMap*     market    = nullptr;
    AntoniAI*      antoni    = nullptr;
    CustomerAI*    customer1 = nullptr;   // Day 1 strange customer
    CustomerAI*    customer2 = nullptr;   // Day 5 strange customer
    TaskSystem*    tasks     = nullptr;
    EventManager*  events    = nullptr;
    ParticleSystem* particles= nullptr;
    Shader*        worldShader=nullptr;

    float prevTime = (float)glfwGetTime();

    // ── GAME LOOP ──────────────────────────────────────────────────────────────
    while (!glfwWindowShouldClose(win)) {
        float now = (float)glfwGetTime();
        float dt  = glm::clamp(now - prevTime, 0.0f, 0.1f);
        prevTime  = now;

        input.PollEvents();
        glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

        // ── ESC: pause / back ─────────────────────────────────────────────────
        if (input.IsKeyPressed(GLFW_KEY_ESCAPE)) {
            if (state.currentScene == GameScene::GAMEPLAY_DAY1  ||
                state.currentScene == GameScene::GAMEPLAY_DAY5  ||
                state.currentScene == GameScene::GAMEPLAY_CHASE) {
                state.isPaused = !state.isPaused;
                input.SetCursorLocked(!state.isPaused);
                audio.PlaySFX(AudioManager::SFX_CLICK);
            } else if (state.currentScene == GameScene::SETTINGS) {
                GameStateMachine::Get().TransitionTo(GameScene::MAIN_MENU);
            }
        }

        sceneTimer += dt;

        switch (state.currentScene) {

        // ── LOADING ──────────────────────────────────────────────────────────
        case GameScene::LOADING: {
            static float loadT = 0.0f;
            loadT += dt * 0.28f; // ~3.5 seconds to full load
            state.loadProgress = glm::min(loadT, 1.0f);
            static const char* msgs[] = {
                "Loading cursed groceries...",
                "Stocking shelves (virtually)...",
                "Hiring Strange Customers...",
                "Sourcing Baby Oil...",
                "Summoning Antoni from Aisle 7...",
                "Mopping the floor... (it didn't work)",
                "READY."
            };
            int msgIdx = (int)(state.loadProgress * 6.99f);
            ui.DrawLoadingScreen(state.loadProgress, msgs[msgIdx]);

            if (state.loadProgress >= 1.0f && !cam) {
                cam      = new Camera({0.f, 1.7f, 3.f});
                market   = new MarketMap();
                market->Init("assets/textures/world_skin.png",
                             "assets/textures/world_skin.png",
                             "assets/textures/shelf_tex.png");
                anthony  = new AntoniAI("assets/models/characters/entity_antoni.obj");
                customer1= new CustomerAI(CustomerType::STRANGE,
                             market->GetZoneCenter("AISLE_A"),
                             "assets/models/characters/entity_strange_customer.obj");
                customer2= new CustomerAI(CustomerType::STRANGE,
                             market->GetZoneCenter("CHECKOUT"),
                             "assets/models/characters/entity_strange_customer.obj");
                tasks    = new TaskSystem();
                tasks->InitDay1Tasks();
                events   = new EventManager();
                particles= new ParticleSystem(1024);
                worldShader = new Shader(
                    "assets/shaders/world/world.vert",
                    "assets/shaders/world/world.frag");
                events->RegisterDay1Events(*anthony, *customer1,
                                           audio, GameStateMachine::Get());
                GameStateMachine::Get().TransitionTo(GameScene::MAIN_MENU);
                audio.PlayBGM(AudioManager::BGM_MENU);
            }
            break;
        }

        // ── MAIN MENU ─────────────────────────────────────────────────────────
        case GameScene::MAIN_MENU: {
            static int hovered = 0;
            int dx=0, dy=0;
            input.Navigate(dx, dy);
            if (dy != 0) {
                hovered = glm::clamp(hovered + dy, 0, 3);
                audio.PlaySFX(AudioManager::SFX_CLICK);
            }
            if (input.Confirm()) {
                audio.PlaySFX(AudioManager::SFX_CLICK);
                if (hovered == 0) {  // NEW GAME
                    GameStateMachine::Get().TransitionTo(GameScene::CUTSCENE_DAY1);
                    audio.StopBGM();
                    sceneTimer = 0.0f;
                } else if (hovered == 1 && SaveLoad::SaveExists()) { // CONTINUE
                    SaveLoad::LoadGame(state);
                    GameStateMachine::Get().TransitionTo(state.currentScene);
                } else if (hovered == 2) { // SETTINGS
                    GameStateMachine::Get().TransitionTo(GameScene::SETTINGS);
                } else if (hovered == 3) { // QUIT
                    glfwSetWindowShouldClose(win, true);
                }
            }
            ui.DrawMainMenu(hovered);
            break;
        }

        // ── SETTINGS ─────────────────────────────────────────────────────────
        case GameScene::SETTINGS:
            ui.DrawSettingsMenu(state);
            // (InputManager handles slider navigation inside DrawSettingsMenu)
            break;

        // ── CUTSCENE: DAY 1 ───────────────────────────────────────────────────
        case GameScene::CUTSCENE_DAY1:
            ui.DrawCutsceneDay1(sceneTimer);
            if (sceneTimer >= 6.0f) {
                GameStateMachine::Get().TransitionTo(GameScene::GAMEPLAY_DAY1);
                input.SetCursorLocked(true);
                audio.PlayBGM(AudioManager::BGM_NORMAL_SHIFT, true, 0.35f);
                sceneTimer = 0.0f;
            }
            break;

        // ── GAMEPLAY: DAY 1 — Normal Shift ────────────────────────────────────
        case GameScene::GAMEPLAY_DAY1:
            if (state.isPaused) {
                // Pause menu handled by helper below
                ui.DrawPauseMenu(0);
            } else {
                post.BeginCapture();

                // Player movement
                glm::vec3 dir{0};
                float speed = PLAYER_SPEED;
                if (input.MoveForward())  dir += cam->Front();
                if (input.MoveBackward()) dir -= cam->Front();
                if (input.MoveLeft())     dir -= cam->Right();
                if (input.MoveRight())    dir += cam->Right();
                dir.y = 0;
                if (glm::length(dir) > 0.01f) dir = glm::normalize(dir);
                cam->Move(dir, speed, dt);
                cam->Update(input.MouseDelta().x, input.MouseDelta().y,
                            state.mouseSensitivity);
                cam->Bob(glm::length(dir) > 0.01f, dt);

                // Collision resolve
                glm::vec3 p = cam->Position();
                AABB playerBox = MakeAABB(p, {0.3f, 0.9f, 0.3f});
                for (auto& wall : market->GetColliders()) {
                    if (playerBox.Intersects(wall)) {
                        glm::vec3 mtv = AABB::Resolve(playerBox, wall);
                        cam->Move(mtv, 1.0f, 1.0f); // direct push
                    }
                }

                // Task interaction
                if (input.Interact())
                    tasks->Update(cam->Position(), true);
                else
                    tasks->Update(cam->Position(), false);

                // Events (poop trigger, Antoni spawn)
                events->Update(dt);

                // Render world
                worldShader->Use();
                worldShader->SetMat4("view", cam->GetViewMatrix());
                worldShader->SetMat4("projection",
                    cam->GetProjectionMatrix(W, H));
                worldShader->SetVec3("viewPos", cam->Position());
                worldShader->SetVec3("lightPos", {0,3,0});
                worldShader->SetFloat("time", now);
                worldShader->SetFloat("fearFactor", state.fearLevel / 100.0f);
                worldShader->SetFloat("chaseFactor", 0.0f);
                market->Draw(*worldShader,
                    cam->GetViewMatrix(), cam->GetProjectionMatrix(W, H),
                    now, state.fearLevel / 100.0f);
                customer1->Draw(*worldShader,
                    cam->GetViewMatrix(), cam->GetProjectionMatrix(W, H));
                particles->Update(dt);
                particles->Draw(*worldShader, cam->GetViewMatrix(),
                    cam->GetProjectionMatrix(W, H),
                    cam->Right(), cam->Front());

                post.EndCapture();
                post.Render(state.fearLevel, now, false, false, false, 0.0f);

                // HUD
                bool nearTask = tasks->IsNearActiveTask(cam->Position());
                std::string taskDesc = tasks->GetActiveTask()
                    ? tasks->GetActiveTask()->description : "Survive.";
                std::string hint = nearTask ? "[E] " +
                    (tasks->GetActiveTask() ? tasks->GetActiveTask()->subText
                     : "Do the thing") : "";
                ui.DrawHUD(state.fearLevel, taskDesc, nearTask, hint,
                           state.playTime, state.hasCarKeys,
                           state.antoniChasing);
                state.playTime += dt;
            }
            break;

        // ── CUTSCENE: POOP EVENT 1 (FLOOR) ────────────────────────────────────
        case GameScene::CUTSCENE_POOP1:
            ui.DrawPoopEvent1(sceneTimer);
            if (sceneTimer < 0.5f)
                audio.PlaySFX("sfx_poop_event");
            if (sceneTimer >= 8.0f) {
                GameStateMachine::Get().TransitionTo(GameScene::CUTSCENE_DAY5);
                sceneTimer = 0.0f;
                audio.PlaySFX("narr_legend_of_antoni");
            }
            break;

        // ── CUTSCENE: DAY 5 + LEGEND ──────────────────────────────────────────
        case GameScene::CUTSCENE_DAY5:
            ui.DrawCutsceneDay5(sceneTimer);
            if (sceneTimer >= 12.0f) {
                tasks->InitDay5Tasks();
                events->RegisterDay5Events(*anthony, *customer2, *market,
                                            audio, GameStateMachine::Get());
                GameStateMachine::Get().TransitionTo(GameScene::GAMEPLAY_DAY5);
                audio.PlayBGM(AudioManager::BGM_TENSION, true, 0.3f);
                input.SetCursorLocked(true);
                sceneTimer = 0.0f;
            }
            break;

        // ── GAMEPLAY: DAY 5 — Tension Shift ──────────────────────────────────
        case GameScene::GAMEPLAY_DAY5:
            // (Identical structure to DAY1 gameplay, different task set + BGM)
            // Antoni is present but ABSENT state — lurks in back room
            // Events fire at task completion checkpoints
            // [Full implementation mirrors GAMEPLAY_DAY1 block above]
            break;

        // ── CUTSCENE: POOP EVENT 2 (REGISTER) ────────────────────────────────
        case GameScene::CUTSCENE_POOP2:
            ui.DrawPoopEvent2(sceneTimer);
            if (sceneTimer < 0.5f) {
                audio.PlaySFX("sfx_poop_event");
                audio.PlaySFX("narr_poop_register");
            }
            if (sceneTimer >= 6.0f) {
                GameStateMachine::Get().TransitionTo(GameScene::CUTSCENE_CHASE);
                sceneTimer = 0.0f;
            }
            break;

        // ── CUTSCENE: BABY OIL + CHASE INTRO ─────────────────────────────────
        case GameScene::CUTSCENE_CHASE:
            ui.DrawBabyOilCutscene(sceneTimer);
            if (sceneTimer < 0.2f) {
                audio.PlaySFX("sfx_baby_oil_splash");
                // Add oil puddles to market
                market->AddOilPuddle(market->GetZoneCenter("CHECKOUT"), 3.0f);
                market->AddOilPuddle(market->GetZoneCenter("AISLE_C"), 2.0f);
                anthony->BeginChase(cam->Position());
                particles->EmitBabyOilSplash(
                    market->GetZoneCenter("CHECKOUT"), 96);
            }
            if (sceneTimer >= 5.0f) {
                audio.StopBGM();
                audio.PlayBGM(AudioManager::BGM_CHASE, true, 0.9f);
                audio.PlaySFX("narr_chase_start");
                state.antoniChasing = true;
                input.SetCursorLocked(true);
                GameStateMachine::Get().TransitionTo(GameScene::GAMEPLAY_CHASE);
                sceneTimer = 0.0f;
            }
            break;

        // ── GAMEPLAY: CHASE — Find Keys + Escape ──────────────────────────────
        case GameScene::GAMEPLAY_CHASE: {
            if (state.isPaused) { ui.DrawPauseMenu(0); break; }

            post.BeginCapture();

            // Player movement + sprint
            glm::vec3 dir{0};
            float speed = PLAYER_SPEED * (input.Sprint() ? 1.8f : 1.0f);
            if (input.MoveForward())  dir += cam->Front();
            if (input.MoveBackward()) dir -= cam->Front();
            if (input.MoveLeft())     dir -= cam->Right();
            if (input.MoveRight())    dir += cam->Right();
            dir.y = 0;
            if (glm::length(dir) > 0.01f) dir = glm::normalize(dir);

            // Oil slip check
            if (market->PlayerInOilPuddle(cam->Position()) && !state.isSlipping) {
                state.isSlipping = true;
                state.slipTimer  = 1.2f;
                audio.PlaySFX("sfx_slip");
            }
            if (state.isSlipping) {
                cam->ApplySlip(dt);
                state.slipTimer -= dt;
                if (state.slipTimer <= 0.0f) {
                    state.isSlipping = false;
                    cam->StopSlip();
                }
            } else {
                cam->Move(dir, speed, dt);
            }

            cam->Update(input.MouseDelta().x, input.MouseDelta().y,
                        state.mouseSensitivity);
            cam->Bob(glm::length(dir) > 0.01f, dt);
            cam->ApplyFearEffect(state.fearLevel, now);

            // Antoni update
            anthony->Update(dt, cam->Position(), now, *particles);

            // Fear level — rises when Antoni near
            float dist = anthony->DistanceTo(cam->Position());
            if (dist < 8.0f)
                state.fearLevel = glm::min(100,
                    state.fearLevel + (int)(FEAR_DRAIN * dt * 60.0f));
            else
                state.fearLevel = glm::max(0,
                    state.fearLevel - (int)(FEAR_REGEN * dt * 60.0f));

            // Car keys pickup
            if (!state.hasCarKeys) {
                float keyDist = glm::distance(cam->Position(),
                                              market->GetCarKeysSpawn());
                if (keyDist < 1.5f && input.Interact()) {
                    state.hasCarKeys = true;
                    audio.PlaySFX("sfx_keys_found");
                    particles->EmitKeySparkle(market->GetCarKeysSpawn());
                }
            }

            // Exit door / car
            if (state.hasCarKeys) {
                float exitDist = glm::distance(cam->Position(),
                                               market->GetCarPos());
                if (exitDist < 2.5f) {
                    audio.PlaySFX("sfx_car_start");
                    audio.StopBGM();
                    GameStateMachine::Get().TransitionTo(GameScene::WIN_SCREEN);
                    sceneTimer = 0.0f;
                }
            }

            // Antoni catch
            if (anthony->CaughtPlayer(cam->Position())) {
                state.deathCount++;
                audio.StopBGM();
                audio.PlaySFX("sfx_antoni_catch");
                GameStateMachine::Get().TransitionTo(GameScene::GAME_OVER);
                sceneTimer = 0.0f;
            }

            // Antoni jumpscare (close but not caught yet)
            if (anthony->IsJumpscare()) {
                GameStateMachine::Get().TransitionTo(GameScene::JUMPSCARE);
                sceneTimer = 0.0f;
            }

            // Render
            worldShader->Use();
            worldShader->SetMat4("view", cam->GetViewMatrix());
            worldShader->SetMat4("projection", cam->GetProjectionMatrix(W, H));
            worldShader->SetVec3("viewPos", cam->Position());
            worldShader->SetVec3("lightPos", {0, 3, 0});
            worldShader->SetFloat("time", now);
            worldShader->SetFloat("fearFactor", state.fearLevel / 100.0f);
            worldShader->SetFloat("chaseFactor", 1.0f);

            market->Draw(*worldShader, cam->GetViewMatrix(),
                         cam->GetProjectionMatrix(W, H), now,
                         state.fearLevel / 100.0f);
            anthony->Draw(*worldShader, cam->GetViewMatrix(),
                          cam->GetProjectionMatrix(W, H));
            particles->Update(dt);
            particles->Draw(*worldShader, cam->GetViewMatrix(),
                            cam->GetProjectionMatrix(W, H),
                            cam->Right(), cam->Front());

            post.EndCapture();
            post.Render(state.fearLevel, now, true,
                        state.isSlipping, false, 0.0f);

            std::string hint = !state.hasCarKeys &&
                glm::distance(cam->Position(), market->GetCarKeysSpawn()) < 3.0f
                ? "[E] Grab car keys — GO GO GO"
                : state.hasCarKeys &&
                  glm::distance(cam->Position(), market->GetCarPos()) < 5.0f
                ? "[E] GET IN THE CAR"
                : "";
            ui.DrawHUD(state.fearLevel, "FIND YOUR CAR KEYS AND ESCAPE",
                       !hint.empty(), hint, state.playTime,
                       state.hasCarKeys, true);
            state.playTime += dt;
            break;
        }

        // ── JUMPSCARE ─────────────────────────────────────────────────────────
        case GameScene::JUMPSCARE:
            sceneTimer += dt;
            audio.PlaySFX("sfx_antoni_catch");
            ui.DrawJumpscare(glm::min(sceneTimer / 1.5f, 1.0f));
            if (sceneTimer >= 1.5f) {
                state.fearLevel = glm::min(100, state.fearLevel + 30);
                GameStateMachine::Get().TransitionTo(GameScene::GAMEPLAY_CHASE);
                sceneTimer = 0.0f;
            }
            break;

        // ── GAME OVER ─────────────────────────────────────────────────────────
        case GameScene::GAME_OVER:
            if (sceneTimer < 0.1f)
                audio.PlaySFX("narr_death");
            ui.DrawGameOver(state.deathCount, state.playTime);
            if (input.Confirm()) {
                if (true /* try again */) {
                    state.fearLevel   = 0;
                    state.hasCarKeys  = false;
                    state.antoniChasing = false;
                    anthony->Reset();
                    cam->Move(market->GetPlayerSpawn() - cam->Position(),
                              1.0f, 1.0f);
                    GameStateMachine::Get().TransitionTo(GameScene::GAMEPLAY_CHASE);
                    audio.PlayBGM(AudioManager::BGM_CHASE, true, 0.9f);
                    sceneTimer = 0.0f;
                }
            }
            break;

        // ── WIN SCREEN ────────────────────────────────────────────────────────
        case GameScene::WIN_SCREEN:
            if (sceneTimer < 0.1f)
                audio.PlaySFX("narr_win");
            ui.DrawWinScreen(state.playTime, state.deathCount);
            if (input.Confirm() && sceneTimer > 3.0f) {
                GameStateMachine::Get().TransitionTo(GameScene::CREDITS);
                sceneTimer = 0.0f;
            }
            break;

        // ── CREDITS ───────────────────────────────────────────────────────────
        case GameScene::CREDITS:
            ui.DrawCredits(sceneTimer * 35.0f);
            if (input.Confirm()) {
                GameStateMachine::Get().Reset();
                GameStateMachine::Get().TransitionTo(GameScene::MAIN_MENU);
                audio.PlayBGM(AudioManager::BGM_MENU);
                sceneTimer = 0.0f;
            }
            break;

        default: break;
        }

        input.EndFrame();
        glfwSwapBuffers(win);
        glfwPollEvents();
    }

    // ── Cleanup ───────────────────────────────────────────────────────────────
    SaveLoad::SaveSettings(state);
    audio.Shutdown();
    delete cam; delete market; delete anthony;
    delete customer1; delete customer2;
    delete tasks; delete events; delete particles; delete worldShader;
    ui.Shutdown();
    glfwDestroyWindow(win);
    glfwTerminate();
    return 0;
}
